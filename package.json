{
  "name": "items-api",
  "version": "1.0.0",
  "private": true,
  "description": "Items API — Express + Prisma + Postgres, delivered via Docker and Fly.io",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "prisma:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://items:items@localhost:5432/items?schema=public} node ./node_modules/prisma/build/index.js validate",
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://items:items@localhost:5432/items?schema=public} node ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node ./node_modules/prisma/build/index.js migrate deploy",
    "smoke:compose": "sh ./scripts/compose-smoke.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "express": "^5.1.0",
    "prisma": "^6.15.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.34.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
